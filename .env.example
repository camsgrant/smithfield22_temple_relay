# ─────────────────────────────────────────────────────────────────────────────
# Temple Relay — Environment Variables Reference
# Copy this file and fill in the values before deploying.
# NEVER commit real credentials to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────

# Your AWS region (find in AWS Settings > View all projects > Overview > Region)
AWS_REGION=us-east-1

# S3 bucket name for the frontend (must be globally unique, e.g. temple-relay-yourname)
S3_BUCKET_NAME=temple-relay-yourname

# The API Gateway URL created during backend deployment (filled in after step 1)
REACT_APP_API_BASE=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# ── Google Sheets ─────────────────────────────────────────────────────────────

# The ID of your Google Sheet — found in the sheet's URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# The name of the tab/sheet inside the spreadsheet (default: Ordinances)
SHEET_NAME=Ordinances

# The public URL of your Google Sheet (shown to users as a "View All" link)
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here/edit

# The full JSON content of your Google service account key
# (paste the entire contents of the downloaded JSON file, on one line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
